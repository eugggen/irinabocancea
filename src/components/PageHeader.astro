---
import PageBack from "./PageBack.astro";
import { site } from "../content";
import { url } from "../lib/url";

interface Props {
  backHref?: string;
  backLabel?: string;
}

const { backHref, backLabel = "Acasă" } = Astro.props;
const homeHref = url();
---

<header class:list={["page-header", !backHref && "page-header--home"]}>
  {
    backHref ? (
      <a
        class="site-brand font-display"
        href={homeHref}
        transition:name="site-brand"
        transition:persist="site-brand"
      >
        {site.titleDisplay}
      </a>
    ) : (
      <span
        class="site-brand font-display"
        transition:name="site-brand"
        transition:persist="site-brand"
      >
        {site.titleDisplay}
      </span>
    )
  }
  {
    backHref ? (
      <PageBack href={backHref} label={backLabel} />
    ) : (
      <span class="page-back page-back--spacer" aria-hidden="true"></span>
    )
  }
</header>
