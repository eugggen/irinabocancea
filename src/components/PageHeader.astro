---
import PageBack from "./PageBack.astro";
import { site } from "../content";
import { isHomePath } from "../lib/nav";
import { url } from "../lib/url";

interface Props {
  backHref?: string;
  backLabel?: string;
}

const { backHref, backLabel = "Acasă" } = Astro.props;
const homeHref = url();
const onHome = isHomePath(Astro.url.pathname);
---

<header class:list={["page-header", onHome && "page-header--home"]}>
  {
    onHome ? (
      <span class="site-brand font-display" transition:name="site-brand">
        {site.titleDisplay}
      </span>
    ) : (
      <a class="site-brand font-display" href={homeHref} transition:name="site-brand">
        {site.titleDisplay}
      </a>
    )
  }
  {
    backHref ? (
      <PageBack href={backHref} label={backLabel} />
    ) : (
      <span class="page-back page-back--spacer" aria-hidden="true"></span>
    )
  }
</header>
