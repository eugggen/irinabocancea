---
import Base from "../layouts/Base.astro";
import BrandIcon from "../components/BrandIcon.astro";
import { contact } from "../content";
import { brandIconPaths } from "../lib/social-brand-icons";

const iconByLabel = {
  Instagram: brandIconPaths.instagram,
  Facebook: brandIconPaths.facebook,
  LinkedIn: brandIconPaths.linkedin,
} as const;
---

<Base title="Contact">
  <div class="shell">
    <h1 class="sr-only">Contact</h1>
    <div class="page contact-grid">
      <div data-reveal>
        <div class="contact-details">
          <a class="phone font-display text-plate" href={contact.phoneHref}>{contact.phone}</a>
          <div class="contact-meta text-body">
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </div>
        </div>
        <ul class="socials socials--stack">
          {
            contact.socials.map((item) => (
              <li>
                <a
                  class="contact-social text-body"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <BrandIcon path={iconByLabel[item.label]} />
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!--
        TODO: Wire this form to an external endpoint or a small PHP script on the host.
        A static upload cannot receive the submission by itself.
      -->
      <form class="form" action="#" method="post" data-astro-reload data-reveal>
        <div class="field">
          <label class="text-quiet" for="nume">{contact.form.name}</label>
          <input id="nume" name="nume" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label class="text-quiet" for="email">{contact.form.email}</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <fieldset class="field field-options">
          <legend class="text-quiet">{contact.form.eventTypesLabel}</legend>
          <ul class="check-list">
            {
              contact.form.eventTypes.map((label) => (
                <li>
                  <label class="check-option text-quiet">
                    <input type="checkbox" name="tip_eveniment" value={label} />
                    <span>{label}</span>
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>
        <div class="field">
          <label class="text-quiet" for="mesaj">{contact.form.message}</label>
          <textarea id="mesaj" name="mesaj" required></textarea>
        </div>
        <button class="submit" type="submit">{contact.form.submit}</button>
      </form>
    </div>
  </div>
</Base>
