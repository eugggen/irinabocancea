---
import Base from "../layouts/Base.astro";
import Story from "../components/Story.astro";
import { despre } from "../content";
import { proseParagraphs } from "../lib/prose";

const paragraphs = proseParagraphs(despre.paragraphs);
---

<Base title="Despre">
  <div class="shell">
    <Story
      title={despre.title}
      lead={despre.lead}
      paragraphs={paragraphs}
      images={despre.images}
      imageAlt={despre.imageAlt}
      galleryLayout="sidebar"
    />
  </div>
</Base>
