---
import Base from "../../layouts/Base.astro";
import Plate from "../../components/Plate.astro";
import { services } from "../../content";
import { url } from "../../lib/url";
---

<Base title="Servicii">
  <div class="shell">
    <h1 class="sr-only">Servicii</h1>
    <ul class="plates page">
      {
        services.map((service) => (
          <li>
            <a class="plate" href={url(`servicii/${service.slug}`)}>
              <h2 class="plate-name font-display text-plate">{service.title}</h2>
              <Plate
                src={service.image}
                alt={service.imageAlt}
                sizes="(min-width: 48rem) 42vw, 88vw"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
