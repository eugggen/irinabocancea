---
import Base from "../../layouts/Base.astro";
import Plate from "../../components/Plate.astro";
import ProseBody from "../../components/ProseBody.astro";
import { services, type Service } from "../../content";
import { proseParagraphs } from "../../lib/prose";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const paragraphs = proseParagraphs(service.paragraphs);
---

<Base title={service.title}>
  <div class="shell">
    <article class="page page-split">
      <div class="page-split-copy">
        <h1 class="title font-display text-title" data-reveal>{service.title}</h1>
        {
          service.lead ? (
            <p class="body text-body" data-reveal>
              {service.lead}
            </p>
          ) : null
        }
        <ProseBody paragraphs={paragraphs} />
      </div>
      <div class="page-split-media">
        <Plate
          src={service.image}
          alt={service.imageAlt}
          aspect="portrait"
          sizes="(min-width: 48rem) 42vw, 88vw"
        />
      </div>
    </article>
  </div>
</Base>
