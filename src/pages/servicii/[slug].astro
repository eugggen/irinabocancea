---
import Base from "../../layouts/Base.astro";
import Story from "../../components/Story.astro";
import { services, type Service } from "../../content";
import { proseParagraphs } from "../../lib/prose";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const paragraphs = proseParagraphs(service.paragraphs);
---

<Base title={service.title}>
  <div class="shell">
    <Story
      title={service.title}
      lead={service.lead}
      paragraphs={paragraphs}
      proseSplitAfter={service.proseSplitAfter}
      images={service.images}
      imageAlt={service.imageAlt}
      imageObjectPosition={service.imageObjectPosition}
    />
  </div>
</Base>
